{%- comment -%} Minimal home slider stub. {%- endcomment -%}
<section class="rg-slider" aria-label="العروض">
  {% for slide in slides %}
    <div class="rg-slider__slide">
      {% if slide.url and slide.url != "" %}
        <a href="{{ slide.url }}">
          <img
            src="{% if slide.mobile_image and slide.mobile_image != '' %}{{ slide.mobile_image }}{% else %}{{ slide.image }}{% endif %}"
            alt="{{ slide.alt }}"
            loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          />
        </a>
      {% else %}
        <img src="{{ slide.image }}" alt="{{ slide.alt }}" />
      {% endif %}
    </div>
  {% endfor %}
</section>
